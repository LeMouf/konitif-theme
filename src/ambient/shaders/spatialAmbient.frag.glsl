precision mediump float;varying vec2 vUv;uniform float uTime;uniform vec3 uFogColor;uniform vec3 uLightColor;uniform float uIntensity;#include "noise.glsl" void main(){vec2 p=vUv-.5;float r=length(p);float beam=smoothstep(.42,0.,abs(p.x))*smoothstep(.55,.05,p.y+.15);float n=noise(vUv*8.+uTime*.03);vec3 col=mix(uFogColor,uLightColor,beam*.55+n*.08)*uIntensity*(1.-r*.8);gl_FragColor=vec4(col,max(0.,.42-r*.55));}
